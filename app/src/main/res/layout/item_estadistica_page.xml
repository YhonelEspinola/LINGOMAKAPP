<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloPagina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Título de Página"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Página 1: Resumen Global -->
        <LinearLayout
            android:id="@+id/layoutP1Resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">
                <!-- Card Entradas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Entradas" android:textSize="10sp" />
                        <TextView android:id="@+id/tvP1Entradas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/success" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card Salidas -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salidas" android:textSize="10sp" />
                        <TextView android:id="@+id/tvP1Salidas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/danger" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <!-- Card Total -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="8dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mov. Totales" android:textSize="10sp" />
                        <TextView android:id="@+id/tvP1Total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvP1ResumenTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#F3F4F6"
                android:padding="12dp"
                android:text="---" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chartP1"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Página 2: Tendencia Mensual -->
        <LinearLayout
            android:id="@+id/layoutP2Tendencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartP2"
                android:layout_width="match_parent"
                android:layout_height="300dp" />
        </LinearLayout>

        <!-- Página 3, 4, 5 (Tablas o Bar Charts) -->
        <LinearLayout
            android:id="@+id/layoutTablaGenerica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TableLayout
                android:id="@+id/tableGenerica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0">
                <TableRow android:background="#F3F4F6" android:paddingVertical="8dp">
                    <TextView android:id="@+id/tvCol1Header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Item" android:textStyle="bold" android:paddingHorizontal="8dp"/>
                    <TextView android:id="@+id/tvCol2Header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Valor" android:textStyle="bold" android:paddingHorizontal="8dp" android:gravity="end"/>
                </TableRow>
            </TableLayout>

            <TextView
                android:id="@+id/tvEstadoVacioTabla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="No hay datos disponibles"
                android:textAlignment="center"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutChartGenerico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chartBarGenerico"
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/chartPieGenerico"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEstadoVacioChart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="No hay datos suficientes para graficar"
                android:textAlignment="center"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Página 8: Costos -->
        <LinearLayout
            android:id="@+id/layoutP8Costos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chartP8"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <TextView
                android:id="@+id/tvP8Diferencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFF3E0"
                android:padding="12dp"
                android:textColor="#E65100"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
