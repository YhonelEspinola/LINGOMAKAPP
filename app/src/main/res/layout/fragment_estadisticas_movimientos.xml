<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Fijo -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Análisis Estadístico"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Selector de Fechas (Exactamente igual que en Movimientos) -->
    <com.lingomak.lingomakapp.ui.custom.SelectorFechasView
        android:id="@+id/selectorFechasEstadisticas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <!-- Texto alternativo para Página 2 (Tendencia) -->
    <TextView
        android:id="@+id/tvLabelFijoPeriodo"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#F3F4F6"
        android:gravity="center"
        android:text="Histórico de Tendencias"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader" />

    <TextView
        android:id="@+id/tvRangoActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Periodo seleccionado"
        android:textAlignment="center"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/selectorFechasEstadisticas" />

    <!-- ViewPager2 para el Carrusel -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerEstadisticas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toTopOf="@id/tabLayoutIndicator"
        app:layout_constraintTop_toBottomOf="@id/tvRangoActual" />

    <!-- Indicador de Puntos (Corregido: tamaño fijo y espaciado real) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutIndicator"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/layoutRecomendacion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tabBackground="@drawable/selector_dot"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabMinWidth="16dp"
        app:tabMaxWidth="16dp"
        app:tabRippleColor="@null" />

    <!-- Recomendación de Stock (Fija abajo) -->
    <LinearLayout
        android:id="@+id/layoutRecomendacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8F5E9"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Recomendación automática"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecomendacionStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#2E7D32"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>