<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFixed"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_selector_bar"
        android:paddingHorizontal="4dp"
        app:chipSpacingHorizontal="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip7D"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="7D"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:chipBackgroundColor="@drawable/selector_chip_segmented"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip30D"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:checked="true"
            android:text="30D"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:chipBackgroundColor="@drawable/selector_chip_segmented"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip12S"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="12S"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:chipBackgroundColor="@drawable/selector_chip_segmented"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip6M"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="6M"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:chipBackgroundColor="@drawable/selector_chip_segmented"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip1A"
            style="@style/Widget.MaterialComponents.Chip.Choice"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:text="1A"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:chipBackgroundColor="@drawable/selector_chip_segmented"
            app:chipStrokeWidth="0dp" />

    </com.google.android.material.chip.ChipGroup>

</androidx.constraintlayout.widget.ConstraintLayout>
