<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/chipGroupFixed"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_selector_bar"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:gravity="center"
        android:weightSum="5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Usamos RadioButtons con estilo de botón para que funcionen como Chips de selección única -->
        <RadioGroup
            android:id="@+id/radioGroupChips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="5">

            <RadioButton
                android:id="@+id/chip7D"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chip_segmented"
                android:button="@null"
                android:gravity="center"
                android:text="7D"
                android:textColor="@color/selector_chip_segmented_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip30D"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chip_segmented"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="30D"
                android:textColor="@color/selector_chip_segmented_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip12S"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chip_segmented"
                android:button="@null"
                android:gravity="center"
                android:text="12S"
                android:textColor="@color/selector_chip_segmented_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip6M"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chip_segmented"
                android:button="@null"
                android:gravity="center"
                android:text="6M"
                android:textColor="@color/selector_chip_segmented_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/chip1A"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chip_segmented"
                android:button="@null"
                android:gravity="center"
                android:text="1A"
                android:textColor="@color/selector_chip_segmented_text"
                android:textSize="11sp"
                android:textStyle="bold" />

        </RadioGroup>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
