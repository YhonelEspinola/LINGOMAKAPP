<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar uso"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra las horas trabajadas por la maquinaria durante la jornada."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvNombreMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excavadora CAT 320"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCodigoMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Código: MAQ-0001"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvTipoMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo: Excavadora"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvHorometroActual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Horómetro actual: 0 h"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <TextView
                    android:id="@+id/tvUltimoMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Último mantenimiento: 0 h"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvIntervaloMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Intervalo: cada 250 h"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Horas trabajadas"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="22dp" />

        <EditText
            android:id="@+id/etHorasUso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:hint="Ingrese horas de uso"
            android:inputType="number"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Observación"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/etObservacion"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_edit_text"
            android:gravity="top"
            android:hint="Observación opcional"
            android:inputType="textMultiLine"
            android:padding="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVistaPrevia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_elevated"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vista previa"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNuevoHorometro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nuevo horómetro: --"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvHorasRestantes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Horas restantes: --"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/tvMensajeMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ingrese las horas trabajadas para calcular el estado del mantenimiento."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progressUsoMaquinaria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnGuardarUso"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Guardar registro"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_primary"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>