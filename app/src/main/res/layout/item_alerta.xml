<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoriaAlerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATEGORÍA"
            android:textColor="#7F0000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvIconoAlerta"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⚠"
                android:textSize="22sp"
                android:textColor="#212121"
                android:background="#F5F5F5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mantenimiento vencido"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMensajeAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción técnica de la incidencia detectada."
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvFechaAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REGISTRO: 01/07/2026"
                    android:textColor="#757575"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvPrioridadAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEVERIDAD: CRÍTICA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#B91C1C"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTomarAccionAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="GESTIONAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    app:backgroundTint="#7F0000" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>