<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoriaAlerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CATEGORÍA"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivIconoAlerta"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:src="@drawable/alert"
                app:tint="@color/alert_warning_text"
                android:background="@drawable/bg_alerta_icono" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mantenimiento vencido"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMensajeAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción técnica de la incidencia detectada."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvFechaAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REGISTRO: 01/07/2026"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/tvPrioridadAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEVERIDAD: CRÍTICA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/danger"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTomarAccionAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:text="TOMAR ACCIÓN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/fixed_white"
                    app:cornerRadius="8dp"
                    app:elevation="0dp"
                    app:backgroundTint="@color/primary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>