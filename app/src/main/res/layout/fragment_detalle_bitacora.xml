<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle de Actividad"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 de mayo, 2024"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Info Principal -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvNombreMaquinaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excavadora CAT 320"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetalleMaquina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CAT · 320D · MAQ-001"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRABAJO REALIZADO"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrabajoRealizadoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excavación de zanja para tubería de 24 pulgadas en sector norte."
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HORÓMETRO INICIAL"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"/>
                        <TextView
                            android:id="@+id/tvHorometroInicialDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8030.0 h"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HORÓMETRO FINAL"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"/>
                        <TextView
                            android:id="@+id/tvHorometroFinalDetalle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8032.5 h"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHorasTotalDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total: 2.5 horas de uso"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/tvOperarioDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registrado por: Juan Pérez"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAuditoriaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Última modificación: ..."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sección Proyecto (Condicional) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProyectoDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFORMACIÓN DEL PROYECTO"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvObraDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Obra: --"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvContratistaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contratista: --"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvUbicacionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ubicación: --"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sección Repostaje (Condicional) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRepostajeDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REPOSTAJE ASOCIADO"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCombustibleDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Combustible: 15.0 Gls (Diesel)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvAceiteDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aceite: 0.0 Gls"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvTipoCargaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Carga: Completa"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarActividad"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="EDITAR ACTIVIDAD"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            app:icon="@drawable/edit"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

    </LinearLayout>

</ScrollView>
