<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle del Mantenimiento"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ficha técnica y registros de ejecución"
            android:textColor="#757575"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAlerta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFF8E1"
            app:strokeColor="#FFC400"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTituloAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ ALERTA DE GESTIÓN"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#7F0000" />

                <TextView
                    android:id="@+id/tvTipoAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:textColor="#212121" />

                <TextView
                    android:id="@+id/tvMensajeAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#757575" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#E0E0E0"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CÓDIGO DE REGISTRO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvCodigoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="MAN-0001"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIPO DE MANTENIMIENTO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvTipoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="PREVENTIVO"
                    android:textColor="#7F0000"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MAQUINARIA ASOCIADA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvMaquinariaDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Excavadora CAT 320"
                    android:textColor="#212121"
                    android:textSize="15sp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tvCodigoMaquinariaDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAT-20260629-1137"
                        android:textColor="#757575"
                        android:textSize="13sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="#757575"
                        android:textSize="13sp"/>
                    <TextView
                        android:id="@+id/tvTipoMaquinariaDetalle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LINEA AMARILLA"
                        android:textColor="#757575"
                        android:textSize="13sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCRIPCIÓN TÉCNICA"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvDescripcionDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cambio de aceite y filtros."
                    android:textColor="#212121"
                    android:textSize="15sp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FECHA" android:textSize="11sp" android:textStyle="bold" android:textColor="#757575"/>
                        <TextView android:id="@+id/tvFechaDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="15/07/2026" android:textColor="#212121" android:textSize="15sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HORÓMETRO" android:textSize="11sp" android:textStyle="bold" android:textColor="#757575"/>
                        <TextView android:id="@+id/tvHorometroDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3500 h" android:textColor="#212121" android:textSize="15sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESPONSABLE" android:textSize="11sp" android:textStyle="bold" android:textColor="#757575"/>
                        <TextView android:id="@+id/tvResponsableDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Juan Perez" android:textColor="#212121" android:textSize="15sp"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PRIORIDAD" android:textSize="11sp" android:textStyle="bold" android:textColor="#757575"/>
                        <TextView android:id="@+id/tvPrioridadDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALTA" android:textColor="#212121" android:textSize="15sp"/>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COSTO ESTIMADO"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvCostoEstimadoDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="S/ 500.00"
                    android:textColor="#212121"
                    android:textSize="15sp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESTADO ACTUAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvEstadoDetalle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_chip_estado_pendiente"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="PENDIENTE"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F5F5F5" android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OBSERVACIONES"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"/>

                <TextView
                    android:id="@+id/tvObservacionesDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin observaciones"
                    android:textColor="#212121"
                    android:textSize="14sp"/>

                <!-- SECCIÓN DE IMÁGENES -->
                <TextView
                    android:id="@+id/tvLabelImagenesReporte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EVIDENCIAS DE REPORTE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvImagenesReporteDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvLabelImagenesFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EVIDENCIAS DE FINALIZACIÓN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvImagenesFinalDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizarMantenimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="FINALIZAR MANTENIMIENTO"
            android:layout_marginTop="24dp"
            android:textAllCaps="true"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="#7F0000"
            app:elevation="0dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerarReporteIA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="GENERAR REPORTE CON IA"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/secondary"
            app:cornerRadius="12dp"
            app:icon="@drawable/report"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarEstado"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="INICIAR MANTENIMIENTO"
            android:layout_marginTop="12dp"
            android:textAllCaps="true"
            android:textColor="#7F0000"
            app:strokeColor="#7F0000"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarMantenimiento"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="EDITAR FICHA"
            android:layout_marginTop="8dp"
            android:textColor="#757575"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>