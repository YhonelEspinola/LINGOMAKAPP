<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="120dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar Maquinaria"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:textSize="28sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra maquinaria pesada de la empresa"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">


                <ImageView
                    android:id="@+id/imgVistaPreviaMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:background="@drawable/bg_image_placeholder"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_maquinaria_placeholder" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSeleccionarImagen"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:text="Seleccionar imagen"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp"
                    app:icon="@android:drawable/ic_menu_gallery" />

                <EditText
                    android:id="@+id/etNombreMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Nombre de maquinaria"
                    android:padding="12dp"
                    android:singleLine="true" />


                <Spinner
                    android:id="@+id/spTipoMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:padding="12dp"/>


                <Spinner
                    android:id="@+id/spMarcaMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:padding="12dp"/>


                <EditText
                    android:id="@+id/etModeloMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Modelo"
                    android:padding="12dp"
                    android:singleLine="true" />


                <EditText
                    android:id="@+id/etPlacaSerie"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Placa o número de serie"
                    android:padding="12dp"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/etAnioMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Año"
                    android:inputType="number"
                    android:padding="12dp"
                    android:singleLine="true" />


                <Spinner
                    android:id="@+id/spEstadoMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etHorometroActual"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Horómetro actual"
                    android:inputType="number"
                    android:padding="12dp"
                    android:singleLine="true" />


                <EditText
                    android:id="@+id/etHorometroUltimoMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Horómetro último mantenimiento"
                    android:inputType="number"
                    android:padding="12dp"
                    android:singleLine="true" />


                <EditText
                    android:id="@+id/etUbicacionActual"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Ubicación actual"
                    android:padding="12dp"
                    android:singleLine="true" />


                <EditText
                    android:id="@+id/etObservacionesMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Observaciones"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarMaquinaria"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Guardar maquinaria"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp" />
                <ProgressBar
                    android:id="@+id/progressGuardarMaquinaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>