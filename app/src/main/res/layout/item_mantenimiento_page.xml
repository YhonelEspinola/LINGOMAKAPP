<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="16dp">

    <!-- Encabezado de Filtros Colapsable -->
    <LinearLayout
        android:id="@+id/btnToggleFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvFiltrosLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FILTROS Y RANGO"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ImageView
            android:id="@+id/ivChevronFiltros"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:id="@+id/dividerFiltros"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        app:layout_constraintTop_toBottomOf="@id/btnToggleFiltros" />

    <!-- Contenedor Colapsable de Filtros -->
    <LinearLayout
        android:id="@+id/layoutFiltrosExpandible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dividerFiltros">

        <!-- Selector de Fechas (Solo visible en Historial) -->
        <LinearLayout
            android:id="@+id/layoutFiltroFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvFiltroFechaEtiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Últimos 30 días"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal" />

            <com.lingomak.lingomakapp.ui.custom.SelectorFechasView
                android:id="@+id/selectorFechas"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFiltroUsuario"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:hint="Filtrar por Usuario"
            android:visibility="gone">

            <AutoCompleteTextView
                android:id="@+id/spFiltroUsuario"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Filtros de Tipo y Estado -->
        <com.lingomak.lingomakapp.utils.SwipeableHorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </com.lingomak.lingomakapp.utils.SwipeableHorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFiltroEstado"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:hint="Filtrar por Estado"
            android:visibility="gone">
            <AutoCompleteTextView
                android:id="@+id/spFiltroEstado"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.lingomak.lingomakapp.utils.SwipeableHorizontalScrollView
            android:id="@+id/scrollEstado"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="2dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </com.lingomak.lingomakapp.utils.SwipeableHorizontalScrollView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMantenimientos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/layoutFiltrosExpandible"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>