<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="120dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Editar Mantenimiento"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualiza la información del mantenimiento"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">


                <TextView
                    android:id="@+id/tvCodigoMantenimientoEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Código: MAN-0001"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaquinariaEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Maquinaria: Excavadora CAT 320"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvCodigoMaquinariaEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Código maquinaria: EXC-0001"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvResponsableEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Responsable: Admin"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo de mantenimiento"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spTipoMantenimientoEditar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_edit_text"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Prioridad"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgPrioridadEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbPrioridadAltaEditar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Alta" />

                    <RadioButton
                        android:id="@+id/rbPrioridadMediaEditar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Media" />

                    <RadioButton
                        android:id="@+id/rbPrioridadBajaEditar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Baja" />

                </RadioGroup>


                <EditText
                    android:id="@+id/etDescripcionEditar"
                    android:layout_width="match_parent"
                    android:layout_height="95dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Descripción"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etFechaProgramadaEditar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:focusable="false"
                    android:hint="Fecha programada"
                    android:inputType="none"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etHorometroProgramadoEditar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Horómetro programado"
                    android:inputType="number"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etCostoEstimadoEditar"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Costo estimado"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etObservacionesEditar"
                    android:layout_width="match_parent"
                    android:layout_height="95dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Observaciones"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evidencias / Reporte Inicial"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEvidenciasEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarEvidenciaEditar"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agregar Imagen"
                    app:icon="@drawable/qr" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarCambiosMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Guardar cambios"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progressEditarMantenimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/btnGuardarMaquinaria"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>