<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="120dp">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar Mantenimiento"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registra los datos reales del mantenimiento ejecutado"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="4dp"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">


                <TextView
                    android:id="@+id/tvCodigoFinalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Código: MAN-0001"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMaquinariaFinalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Maquinaria: Excavadora CAT 320"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvDescripcionFinalizar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción: Cambio de aceite"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp" />


                <EditText
                    android:id="@+id/etFechaRealizada"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:background="@drawable/bg_edit_text"
                    android:focusable="false"
                    android:hint="Fecha realizada"
                    android:inputType="none"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etHorometroReal"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Lectura actual del horómetro"
                    android:inputType="number"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etCostoReal"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Costo real"
                    android:inputType="numberDecimal"
                    android:padding="12dp" />


                <EditText
                    android:id="@+id/etObservacionesFinales"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top"
                    android:hint="Observaciones finales"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinalizarMantenimiento"
                    android:layout_width="match_parent"
                    android:layout_height="75dp"
                    android:layout_marginTop="20dp"
                    android:text="Finalizar mantenimiento"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/holo_orange_dark"
                    app:cornerRadius="14dp" />

                <ProgressBar
                    android:id="@+id/progressFinalizarMantenimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/btnGuardarMaquinaria"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>